# ── Python ──────────────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Secrets / machine-specific config ──────────────────────────────────
.env
.env.*
config/config.local.ini

# ── Runtime data (regenerated locally, not source) ─────────────────────
data/*.db
data/*.SQLite3
data/*.sqlite3
data/*.index
data/*.pkl
data/*.bin
*.bin
data/corrections_learned.json
data/schema_cache.json
data/range_cache.json
data/**/*.db
data/**/*.SQLite3
data/**/*.sqlite3
!data/README_DATA.txt
!data/.gitkeep
!data/backgrounds/README.txt

# ── Logs & transcripts ───────────────────────────────────────────────────
logs/*.log
logs/transcript_*.log
logs/*.png
logs/multiverse.pid
logs/windowverse.pid
!logs/.gitkeep

# ── OS / editor cruft ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ── Front-end build artifacts (once bundling is introduced) ────────────
node_modules/
dist/
build/

# ── Packaging / misc ─────────────────────────────────────────────────────
*.spec
!multiverse.spec
installer/output/
release/
*.zip
!release/.gitkeep
